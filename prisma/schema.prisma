generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id      Int     @id @default(autoincrement())
  name    String? @db.VarChar(255)
  email   String? @db.VarChar(255)
  address String? @db.VarChar(255)
}
